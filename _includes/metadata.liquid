{% capture author_name %}{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}{% endcapture %}
{% assign author_name = author_name | strip %}
{% assign meta_description = page.description | default: site.description | strip_html | strip_newlines | strip %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}
{% if page.url == '/' or page.title == blank or page.title == 'blank' %}
  {% assign meta_title = author_name %}
{% else %}
  {% capture meta_title %}{{ page.title }} | {{ author_name }}{% endcapture %}
{% endif %}

<!-- Standard metadata -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="author" content="{{ author_name | escape }}">
<meta name="description" content="{{ meta_description | escape }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{{ page.keywords | default: site.keywords | escape }}">
{% endif %}
<title>{{ meta_title | strip | escape }}</title>

{% if site.enable_google_verification and site.google_site_verification %}
  <meta name="google-site-verification" content="{{ site.google_site_verification }}">
{% endif %}
{% if site.enable_bing_verification and site.bing_site_verification %}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification }}">
{% endif %}

{% if site.serve_og_meta %}
  {% assign social_image = page.og_image | default: site.og_image %}
  <!-- Open Graph and social cards -->
  <meta property="og:site_name" content="{{ author_name | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ meta_title | strip | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ meta_description | escape }}">
  <meta property="og:locale" content="{{ site.lang }}">
  <meta name="twitter:card" content="{% if social_image != blank %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ meta_title | strip | escape }}">
  <meta name="twitter:description" content="{{ meta_description | escape }}">
  {% if social_image != blank %}
    <meta property="og:image" content="{{ social_image | absolute_url }}">
    <meta name="twitter:image" content="{{ social_image | absolute_url }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org %}
  {% assign socials = site.data.socials %}
  {% capture person_id %}{{ site.url }}{{ site.baseurl }}/#person{% endcapture %}
  {% capture website_id %}{{ site.url }}{{ site.baseurl }}/#website{% endcapture %}
  <!-- Researcher and website structured data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": {{ person_id | jsonify }},
          "name": {{ author_name | jsonify }},
          "url": {{ site.url | append: site.baseurl | append: '/' | jsonify }},
          "jobTitle": {{ site.data.resume.basics.label | jsonify }},
          "description": {{ site.data.resume.basics.summary | jsonify }},
          "sameAs": [
            {% assign separator = '' %}
            {% if socials.github_username %}
              {{ separator }}{% capture social_url %}https://github.com/{{ socials.github_username }}{% endcapture %}{{ social_url | jsonify }}{% assign separator = ',' %}
            {% endif %}
            {% if socials.linkedin_username %}
              {{ separator }}{% capture social_url %}https://www.linkedin.com/in/{{ socials.linkedin_username }}{% endcapture %}{{ social_url | jsonify }}{% assign separator = ',' %}
            {% endif %}
            {% if socials.orcid_id %}
              {{ separator }}{% capture social_url %}https://orcid.org/{{ socials.orcid_id }}{% endcapture %}{{ social_url | jsonify }}{% assign separator = ',' %}
            {% endif %}
            {% if socials.scholar_userid %}
              {{ separator }}{% capture social_url %}https://scholar.google.com/citations?user={{ socials.scholar_userid }}{% endcapture %}{{ social_url | jsonify }}
            {% endif %}
          ]
        },
        {
          "@type": "WebSite",
          "@id": {{ website_id | jsonify }},
          "url": {{ site.url | append: site.baseurl | append: '/' | jsonify }},
          "name": {{ author_name | jsonify }},
          "publisher": { "@id": {{ person_id | jsonify }} }
        },
        {
          "@type": "WebPage",
          "@id": {{ canonical_url | append: '#webpage' | jsonify }},
          "url": {{ canonical_url | jsonify }},
          "name": {{ meta_title | strip | jsonify }},
          "description": {{ meta_description | jsonify }},
          "isPartOf": { "@id": {{ website_id | jsonify }} },
          "about": { "@id": {{ person_id | jsonify }} }
        }
      ]
    }
  </script>
{% endif %}
