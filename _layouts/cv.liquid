---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          target="_blank"
          rel="noopener noreferrer"
          class="float-right"
          aria-label="Download CV as PDF"
        >
          <i class="fa-solid fa-file-pdf" aria-hidden="true"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    <div class="cv">
      {% for section in site.jsonresume %}
        {% assign data = site.data.resume[section] %}
        {% if data == null or data.size == 0 %} {% continue %} {% endif %}
        <a class="anchor" id="{{ section }}"></a>
        <section class="card mt-3 p-3" aria-labelledby="cv-{{ section }}">
          <h2 id="cv-{{ section }}" class="card-title h3 font-weight-medium">{{ section | capitalize }}</h2>
          <div>
            {% case section %}
              {% when 'basics' %}
                {% include resume/basics.liquid %}
              {% when 'education' %}
                {% include resume/education.liquid %}
              {% when 'work' %}
                {% include resume/work.liquid %}
              {% when 'volunteer' %}
                {% include resume/volunteer.liquid %}
              {% when 'projects' %}
                {% include resume/projects.liquid %}
              {% when 'awards' %}
                {% include resume/awards.liquid %}
              {% when 'skills' %}
                {% include resume/skills.liquid %}
              {% when 'publications' %}
                {% include resume/publications.liquid %}
              {% when 'languages' %}
                {% include resume/languages.liquid %}
              {% when 'interests' %}
                {% include resume/interests.liquid %}
              {% when 'certificates' %}
                {% include resume/certificates.liquid %}
            {% endcase %}
          </div>
        </section>
      {% endfor %}
    </div>
  </article>
</div>
